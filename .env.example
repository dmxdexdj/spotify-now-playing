# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in your Spotify app exactly.
# Local test:   http://127.0.0.1:3000/callback
# Hosted:       https://nowplaying.YOUR-TAILNET.ts.net/callback  (or your own https domain)
REDIRECT_URI=http://127.0.0.1:3000/callback

# Protects /login and /customize. REQUIRED if the server is reachable by anyone else.
ADMIN_KEY=

# --- Docker / Tailscale only ---
IMAGE=ghcr.io/YOUR-GITHUB-NAME/spotify-now-playing:latest
TS_AUTHKEY=
TS_HOSTNAME=nowplaying
# Folder on the host that holds serve.json and data/
APP_DIR=.
