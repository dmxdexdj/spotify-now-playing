# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Protects /login and /customize. Any long random string.
ADMIN_KEY=

# --- Optional ---
# Redirect URI override. Normally leave empty: it's worked out from the address you open /login on.
# Set it only if you're behind a proxy that doesn't send X-Forwarded-Proto, e.g. https://nowplaying.example.com/callback
REDIRECT_URI=
IMAGE=ghcr.io/dmxdexdj/spotify-now-playing:latest
PORT=3000
# How often (ms) the server asks Spotify while an overlay is open. Minimum 1500.
POLL_MS=2500
# Host folder that contains data/ (tokens.json + settings.json)
APP_DIR=.

# --- examples/ only ---
TUNNEL_TOKEN=
TS_AUTHKEY=
TS_HOSTNAME=nowplaying
TS_EXTRA_ARGS=
